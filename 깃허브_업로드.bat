@echo off
chcp 65001 > nul
title 깃허브(GitHub) 자산관리대장 업로드

echo ====================================================================
echo   [기업 고정자산 관리대장] GitHub 원격 저장소에 업로드를 시작합니다.
echo   대상 저장소: https://github.com/shwmej79-hub/items.git
echo ====================================================================
echo.

"C:\Program Files\Git\cmd\git.exe" push -u origin main

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ====================================================================
    echo   [성공] 깃허브 저장소(items)에 성공적으로 업로드되었습니다!
    echo   확인 링크: https://github.com/shwmej79-hub/items
    echo ====================================================================
) else (
    echo.
    echo ====================================================================
    echo   [알림] 업로드가 완료되지 않았습니다.
    echo   화면에 나타난 GitHub 로그인 / 권한 승인을 완료해 주세요.
    echo ====================================================================
)

echo.
pause
